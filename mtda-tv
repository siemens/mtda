class MainHandler(tornado.web.RequestHandler):
    def get(self):
        self.render("tv.html")


class AgentsHandler(tornado.web.RequestHandler):
    """Returns JSON list of discovered agents and their status."""
    def get(self):
        tracker = self.application.settings['tracker']
        gateway = self.application.settings['gateway']
        agents = []
        for name, agent in tracker.agents.items():
            agents.append({
                'name': name,
                'address': agent.address,
                'port': agent.port,
                'www_url': agent.www_url,
                'gateway_url': gateway.agent_url(name),
                'has_snapshot': agent.snapshot is not None,
                'version': agent.version,
                'uptime': agent.uptime,
            })
        self.set_header("Content-Type", "application/json")
        self.write(json.dumps(agents))


class TraefikConfigHandler(tornado.web.RequestHandler):
    """Renders discovered agents as a Traefik HTTP provider dynamic
    configuration (https://doc.traefik.io/traefik/providers/http/).

    Each agent gets a router matching <gateway.prefix>/<name>/... , a
    matching stripPrefix middleware (so the agent's own mtda-www still
    sees paths rooted at /), and a service pointing at the agent's
    www_url. Traefik polls this endpoint on an interval and hot-applies
    the result with no reload/restart, so routes stay in sync with
    ZeroConf discovery. Returns 404 unless gateway support is enabled
    via the [gateway] config.d fragment (see configs/20-gateway.conf).
    """

    ROUTE_RE = re.compile(r'[^a-zA-Z0-9_-]')

    def get(self):
        gateway = self.application.settings['gateway']
        if not gateway.enabled:
            self.set_status(404)
            self.write("gateway support is not enabled")
            return

        tracker = self.application.settings['tracker']
        routers = {}
        middlewares = {}
        services = {}

        for name, agent in tracker.agents.items():
            # Traefik router/service/middleware names must be safe for
            # use as map keys; sanitize the (user-controlled) agent name.
            slug = self.ROUTE_RE.sub('-', name)
            prefix = gateway.agent_prefix(name)
            router = {
                "rule": f"PathPrefix(`{prefix}`)",
                "service": f"agent-{slug}",
            }

            if gateway.strip_prefix:
                strip_key = f"strip-{slug}"
                middlewares[strip_key] = {
                    "stripPrefix": {"prefixes": [prefix]}
                }
                router["middlewares"] = [strip_key]

            routers[f"agent-{slug}"] = router
            services[f"agent-{slug}"] = {
                "loadBalancer": {
                    "servers": [{"url": agent.www_url}]
                }
            }

        config = {
            "http": {
                "routers": routers,
                "middlewares": middlewares,
                "services": services,
            }
        }
        self.set_header("Content-Type", "application/json")
        self.write(json.dumps(config))


class SnapshotHandler(tornado.web.RequestHandler):
    """Serves the latest snapshot for a given agent."""
    def get(self, agent_name):
        tracker = self.application.settings['tracker']
        agents = tracker.agents
        agent = agents.get(agent_name)
        if agent is None or agent.snapshot is None:
            self.set_status(404)
            self.write("No snapshot available")
            return
        self.set_header("Content-Type",
                        agent.content_type or "image/jpeg")
        self.set_header("Cache-Control", "no-cache")
        self.write(agent.snapshot)


class MjpegStreamHandler(tornado.web.RequestHandler):
    """Serves an MJPEG stream for a given agent (multipart/x-mixed-replace).
    The browser displays frames seamlessly with no flicker."""

    BOUNDARY = "mtda-tv-frame"

    def initialize(self):
        self._auto_finish = False

    async def get(self, agent_name):
        tracker = self.application.settings['tracker']
        interval = tracker._poll_interval

        self.set_header("Content-Type",
                        f"multipart/x-mixed-replace; "
                        f"boundary={self.BOUNDARY}")
        self.set_header("Cache-Control", "no-cache")
        self.set_header("Connection", "close")
        await self.flush()

        while True:
            agents = tracker.agents
            agent = agents.get(agent_name)
            if agent is not None and agent.snapshot is not None:
                frame = agent.snapshot
                content_type = agent.content_type or "image/jpeg"
                header = (f"--{self.BOUNDARY}\r\n"
                          f"Content-Type: {content_type}\r\n"
                          f"Content-Length: {len(frame)}\r\n\r\n")
                try:
                    self.write(header.encode())
                    self.write(frame)
                    self.write(b"\r\n")
                    await self.flush()
                except Exception:
                    break
            await asyncio.sleep(interval)
        self.finish()


class AssetsHandler(tornado.web.StaticFileHandler):
    pass


# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------

class Service:

    def __init__(self):
        parser = argparse.ArgumentParser(
            description="MTDA TV - multi-agent video grid")
        parser.add_argument('-p', '--port', type=int, default=5005,
                            help='HTTP port (default: 5005)')
        parser.add_argument('-H', '--host', default='0.0.0.0',
                            help='Bind address (default: 0.0.0.0)')
        parser.add_argument('-i', '--interval', type=float, default=2.0,
                            help='Snapshot poll interval in seconds '
                                 '(default: 2.0)')
        args = parser.parse_args()
        self._port = args.port
        self._host = args.host
        self._interval = args.interval

    async def run(self):
        tracker = AgentTracker(poll_interval=self._interval)
        tracker.start_discovery()
        gateway = GatewayConfig()
        if gateway.enabled:
            logger.info(f"gateway support enabled (prefix={gateway.prefix})")

        self.executor = concurrent.futures.ThreadPoolExecutor(max_workers=4)

        application = tornado.web.Application([
            (r"/", MainHandler),
            (r"/api/agents", AgentsHandler),
            (r"/api/traefik-config", TraefikConfigHandler),
            (r"/api/snapshot/(.*)", SnapshotHandler),
            (r"/api/stream/(.*)", MjpegStreamHandler),
            (r"/assets/(.*)", AssetsHandler, {
                "path": os.path.join(BASE_DIR, "assets")
            }),
        ], template_path=os.path.join(BASE_DIR, "templates"),
           tracker=tracker, gateway=gateway, debug=False)

        application.listen(self._port, self._host)
        logger.info(f"mtda-tv listening on http://{self._host}:{self._port}")

        # Periodic polling in the thread pool
        async def poll_loop():
            while True:
                loop = asyncio.get_event_loop()
                await loop.run_in_executor(self.executor, tracker.poll_all)
                await asyncio.sleep(self._interval)

        asyncio.create_task(poll_loop())
        await asyncio.Event().wait()


if __name__ == '__main__':
    srv = Service()
    asyncio.run(srv.run())
