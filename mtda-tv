# ---------------------------------------------------------------------------
# Gateway configuration - lets mtda-tv act as a discovery source for a
# reverse proxy (e.g. Traefik's HTTP provider) so agent tiles can be
# reached through a single hostname instead of linking directly to each
# agent's own mtda-www instance. Disabled unless a "mtda-tv-gateway"-style
# config.d fragment enables it (see configs/20-gateway.conf).
# ---------------------------------------------------------------------------

class GatewayConfig:

    def __init__(self):
        self.enabled = False
        self.prefix = '/agents'
        self.strip_prefix = True
        self.base_url = ''
        self._load()

    def _config_files(self):
        files = []
        if os.path.exists('/etc/mtda'):
            files.append(os.path.join('/etc', 'mtda', 'config'))
        if os.path.exists('/etc/mtda/config.d'):
            fragments = glob.glob('/etc/mtda/config.d/*.conf')
            if len(fragments) > 0:
                files.extend(sorted(fragments))
        home = os.getenv('HOME', '')
        if home != '':
            files.append(os.path.join(home, '.mtda', 'config'))
        return files

    def _load(self):
        parser = configparser.ConfigParser()
        parser.read(self._config_files())
        if not parser.has_section('gateway'):
            return
        self.enabled = parser.getboolean(
            'gateway', 'enabled', fallback=self.enabled)
        self.prefix = parser.get(
            'gateway', 'prefix', fallback=self.prefix).rstrip('/')
        self.strip_prefix = parser.getboolean(
            'gateway', 'strip_prefix', fallback=self.strip_prefix)
        self.base_url = parser.get(
            'gateway', 'base_url', fallback=self.base_url).rstrip('/')

    def agent_prefix(self, name):
        return f'{self.prefix}/{name}'

    def agent_url(self, name):
        if not self.enabled:
            return None
        return f'{self.base_url}{self.agent_prefix(name)}/'


# ---------------------------------------------------------------------------
# Agent tracker - discovers and polls MTDA instances
# ---------------------------------------------------------------------------

class AgentInfo:
    """Tracks a discovered MTDA agent."""

    def __init__(self, name, address, port):
        self.name = name
        self.address = address
        self.port = port
        self.snapshot = None
        self.content_type = None
        self.power = None
        self.version = None
        self.uptime = None
        self.www_port = CONSTS.DEFAULTS.WWW_PORT

    @property
    def grpc_target(self):
        return f'{self.address}:{self.port}'

    @property
    def www_url(self):
        return f'http://{self.address}:{self.www_port}/'


class AgentTracker:
    """Discovers MTDA agents via ZeroConf and polls them for snapshots."""

    def __init__(self, poll_interval=2.0):
        self._agents = {}
        self._lock = threading.Lock()
        self._poll_interval = poll_interval
        self._running = False

    @property
    def agents(self):
        with self._lock:
            return dict(self._agents)

    def on_service_event(self, event, name, info=None):
        agent_name = name.replace(f'.{CONSTS.MDNS.TYPE}', '')
        if event in ("ADD", "UPDATE") and info is not None:
            address = socket.inet_ntoa(info.addresses[0])
            port = info.port
            with self._lock:
                if agent_name not in self._agents:
                    logger.info(f"Discovered agent: {agent_name} "
                                f"at {address}:{port}")
                self._agents[agent_name] = AgentInfo(
                    agent_name, address, port)
        elif event == "REMOVE":
            with self._lock:
                if agent_name in self._agents:
                    logger.info(f"Agent removed: {agent_name}")
                    del self._agents[agent_name]

    def start_discovery(self):
        """Start ZeroConf browsing in a background thread."""
        from mtda.discovery import Watcher
        self._watcher = Watcher(
            CONSTS.MDNS.TYPE, onServiceEvent=self.on_service_event)
        self._discovery_thread = threading.Thread(
            target=self._watcher.listen, daemon=True)
        self._discovery_thread.start()

    def stop(self):
        self._running = False
        if hasattr(self, '_watcher'):
            self._watcher.shutdown()

    def poll_agent(self, agent):
        """Fetch snapshot and metadata from a single agent via gRPC."""
        try:
            channel = grpc.insecure_channel(agent.grpc_target)
            stub = mtda_pb2_grpc.MtdaServiceStub(channel)

            # Fetch snapshot (best-effort: agents without a video source
            # configured will fail here and should not prevent the other
            # metadata below from being fetched)
            try:
                chunks = stub.VideoSnapshot(
                    mtda_pb2.Empty(), timeout=5)
                data = bytearray()
                content_type = None
                for chunk in chunks:
                    if chunk.content_type:
                        content_type = chunk.content_type
                    data.extend(chunk.data)
                if data:
                    agent.snapshot = bytes(data)
                    agent.content_type = content_type
            except Exception as e:
                logger.debug(f"VideoSnapshot failed for {agent.name}: {e}")

            # Fetch agent info (version, www_port, etc.)
            try:
                resp = stub.AgentInfo(
                    mtda_pb2.Empty(), timeout=5)
                info = dict(resp.info)
                agent.version = info.get('version')
                www_port = info.get('www_port')
                if www_port:
                    agent.www_port = int(www_port)
            except Exception as e:
                logger.debug(f"AgentInfo failed for {agent.name}: {e}")

            # Fetch target uptime
            try:
                resp = stub.TargetUptime(
                    mtda_pb2.Empty(), timeout=5)
                agent.uptime = resp.uptime or None
            except Exception:
                pass

            channel.close()
        except Exception as e:
            logger.debug(f"Failed to poll {agent.name}: {e}")

    def poll_all(self):
        """Poll all known agents for updated snapshots."""
        agents = self.agents
        for agent in agents.values():
            self.poll_agent(agent)


